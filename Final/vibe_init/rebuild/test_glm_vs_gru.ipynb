{
 "cells": [
  {
   "cell_type": "markdown",
   "id": "cell-0",
   "metadata": {},
   "source": [
    "# PhysioNet 2019 Utility — GLM vs GRU Comparison\n",
    "\n",
    "Compares **LogisticGLM vs GRU** models across training sizes and bootstrap sample sizes.\n",
    "\n",
    "**Note:** For XGBoost comparison, install with: `pip install xgboost`\n",
    "\n",
    "## Test Grid\n",
    "| Parameter | Values |\n",
    "|---|---|\n",
    "| Models | LogisticGLM · GRU |\n",
    "| Training patients | 50 · 100 · 200 |\n",
    "| Bootstrap patients / sample | 25 · 50 |\n",
    "| Bootstrap iterations | 3 per config |\n",
    "| Total evals | 2 × 3 × 2 × 3 = 36 |"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-1",
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys, logging\n",
    "from pathlib import Path\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from tqdm.auto import tqdm\n",
    "\n",
    "sys.path.insert(0, '.')\n",
    "logging.basicConfig(level=logging.WARNING)\n",
    "\n",
    "from data_loader import load_physionet_files, add_hours_until_sepsis, split_patients_by_status, get_rows_for_patients\n",
    "from bootstrap import BootstrapResampler\n",
    "from models import LogisticGLM, GRUModel\n",
    "from training import BootstrapEvaluator\n",
    "\n",
    "print('✓ Imports OK')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cell-2",
   "metadata": {},
   "source": [
    "## Load Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-3",
   "metadata": {},
   "outputs": [],
   "source": [
    "DATA_DIR = Path('../data/physionet_sepsis')\n",
    "print('Loading PhysioNet data...')\n",
    "raw_df = load_physionet_files(DATA_DIR)\n",
    "df = add_hours_until_sepsis(raw_df, keep_post_onset=True)\n",
    "print(f'✓ {df[\"patient_id\"].nunique():,} patients · {len(df):,} rows')\n",
    "print(f'  Sepsis prevalence: {100*df[\"SepsisLabel\"].mean():.1f}%')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cell-4",
   "metadata": {},\n",
   "source": [
    "## Configuration & Execution"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-5",
   "metadata": {},
   "outputs": [],
   "source": [
    "MODELS = [('LogisticGLM', LogisticGLM), ('GRU', GRUModel)]\n",
    "TRAIN_SIZES = [50, 100, 200]\n",
    "BOOTSTRAP_SIZES = [25, 50]\n",
    "N_ITER = 3\n",
    "RANDOM_STATE = 42\n",
    "\n",
    "records = []\n",
    "\n",
    "for model_name, model_class in tqdm(MODELS, desc='Models'):\n",
    "    for train_size in tqdm(TRAIN_SIZES, desc='  Train size', leave=False):\n",
    "        train_pids, boot_pids = split_patients_by_status(\n",
    "            df, n_train_patients=train_size, random_state=RANDOM_STATE, stratify_by_sepsis=True\n",
    "        )\n",
    "        train_df = get_rows_for_patients(df, train_pids)\n",
    "\n",
    "        for boot_size in tqdm(BOOTSTRAP_SIZES, desc='    Boot size', leave=False):\n",
    "            resampler = BootstrapResampler(\n",
    "                bootstrap_pool_patient_ids=boot_pids, full_df=df, n_iterations=N_ITER,\n",
    "                bootstrap_sample_size=boot_size, random_state=RANDOM_STATE\n",
    "            )\n",
    "\n",
    "            evaluator = BootstrapEvaluator(\n",
    "                model=model_class(), train_df=train_df,\n",
    "                label_column='SepsisLabel', patient_id_column='patient_id'\n",
    "            )\n",
    "\n",
    "            for i in range(N_ITER):\n",
    "                _, boot_df = resampler.generate_iteration(i)\n",
    "                m = evaluator.evaluate_iteration(boot_df, i, compute_per_group=True, group_column='Gender')\n",
    "\n",
    "                row = dict(\n",
    "                    model=model_name, train_size=train_size, boot_size=boot_size, iteration=i,\n",
    "                    auroc=m.get('auroc', np.nan), recall=m.get('recall', np.nan),\n",
    "                    accuracy=m.get('accuracy', np.nan), utility=m.get('utility', np.nan),\n",
    "                )\n",
    "                if 'per_group' in m:\n",
    "                    for g, gm in m['per_group'].items():\n",
    "                        row[f'utility_g{int(g)}'] = gm.get('utility', np.nan)\n",
    "                records.append(row)\n",
    "\n",
    "results = pd.DataFrame(records)\n",
    "print(f'\\n✓ {len(results)} evaluations completed')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cell-6",
   "metadata": {},
   "source": [
    "## Results & Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-7",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Summary by model\n",
    "print('\\n' + '='*60)\n",
    "print('MODEL COMPARISON SUMMARY')\n",
    "print('='*60)\n",
    "summary = results.groupby('model')[['utility', 'auroc', 'recall']].agg(['mean', 'std']).round(4)\n",
    "print(summary)\n",
    "\n",
    "# Best config per model\n",
    "print('\\n' + '='*60)\n",
    "print('BEST CONFIGURATIONS')\n",
    "print('='*60)\n",
    "for model_name in [m[0] for m in MODELS]:\n",
    "    best = results[results['model']==model_name].loc[results[results['model']==model_name]['utility'].idxmax()]\n",
    "    print(f'\\n{model_name}:')\n",
    "    print(f'  Utility: {best[\"utility\"]:.4f}')\n",
    "    print(f'  AUROC: {best[\"auroc\"]:.4f}')\n",
    "    print(f'  Recall: {best[\"recall\"]:.4f}')\n",
    "    print(f'  Config: {int(best[\"train_size\"])}pt train, {int(best[\"boot_size\"])}pt boot')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-8",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Visualization\n",
    "fig, axes = plt.subplots(1, 2, figsize=(13, 4))\n",
    "\n",
    "for metric, ax, title in [('utility', axes[0], 'Utility'), ('auroc', axes[1], 'AUROC')]:\n",
    "    for model_name in [m[0] for m in MODELS]:\n",
    "        data = results[results['model']==model_name].groupby('train_size')[metric].agg(['mean','std']).reset_index()\n",
    "        ax.errorbar(data['train_size'], data['mean'], yerr=data['std'], label=model_name, marker='o', capsize=5)\n",
    "    ax.set_xlabel('Training patients')\n",
    "    ax.set_ylabel(title)\n",
    "    ax.set_title(f'{title} vs Training Size')\n",
    "    ax.legend()\n",
    "    ax.grid(alpha=0.3)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('glm_vs_gru_comparison.png', dpi=150)\n",
    "plt.show()\n",
    "print('✓ glm_vs_gru_comparison.png')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-9",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Export\n",
    "results.to_csv('glm_vs_gru_results.csv', index=False)\n",
    "print('✓ glm_vs_gru_results.csv')\n",
    "print('\\nReady for analysis or XGBoost comparison (install: pip install xgboost)')"
   ]
  }
 ],
